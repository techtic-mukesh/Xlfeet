{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'section-contact-us.css' | asset_url | stylesheet_tag }}

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.contact-us-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
}

@media screen and (max-width: 990px) {
  .contact-us-grid {
    grid-template-columns: 1fr;
  }
}

.contact-left h2 {
  margin-bottom: 20px;
}

.contact-info {
  margin-bottom: 24px;
}

.contact-info h4 {
  margin-bottom: 6px;
  font-weight: 600;
}

.contact-form-card {
  background: rgb(var(--color-background));
  border-radius: 12px;
  padding: 32px;
}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="contact-us-grid">

      <!-- LEFT SIDE -->
      <div class="contact-left">
        {% if section.settings.heading != blank %}
          <h2 class="{{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.address != blank %}
          <div class="contact-info">
            <h4>Address</h4>
            {{ section.settings.address }}
          </div>
        {% endif %}

        {% if section.settings.working_hours != blank %}
          <div class="contact-info">
            <h4>Working Hours</h4>
            {{ section.settings.working_hours }}
          </div>
        {% endif %}

        {% if section.settings.phone != blank %}
          <div class="contact-info">
            <h4>Telephone</h4>
            <a href="tel:{{ section.settings.phone }}">
              {{ section.settings.phone }}
            </a>
          </div>
        {% endif %}

        {% if section.settings.show_social %}
          <div class="contact-info">
            {% render 'social-icons' %}
          </div>
        {% endif %}
      </div>

      <!-- RIGHT SIDE (DEFAULT SHOPIFY FORM – DESIGN ONLY) -->
      <div class="contact-form-card">
        {%- liquid
          assign contact_form_class = 'isolate'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
          endif
        -%}

        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}

          {%- if form.posted_successfully? -%}
            <h2 class="form-status form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message" role="alert">
              {{ 'templates.contact.form.error_heading' | t }}
            </div>
          {%- endif -%}

          <div class="contact__fields">
            <div class="field">
              <input class="field__input" type="text" id="ContactForm-name"
                name="contact[name]"
                placeholder="{{ 'templates.contact.form.name' | t }}">
              <label class="field__label" for="ContactForm-name">
                {{ 'templates.contact.form.name' | t }}
              </label>
            </div>

            <div class="field">
              <input class="field__input" type="email" id="ContactForm-email"
                name="contact[email]" required
                placeholder="{{ 'templates.contact.form.email' | t }}">
              <label class="field__label" for="ContactForm-email">
                {{ 'templates.contact.form.email' | t }}
              </label>
            </div>
          </div>

          <div class="field">
            <input class="field__input" type="tel" id="ContactForm-phone"
              name="contact[phone]"
              placeholder="{{ 'templates.contact.form.phone' | t }}">
            <label class="field__label" for="ContactForm-phone">
              {{ 'templates.contact.form.phone' | t }}
            </label>
          </div>

          <div class="field">
            <textarea rows="6" id="ContactForm-body"
              class="field__input"
              name="contact[body]"
              placeholder="{{ 'templates.contact.form.comment' | t }}"></textarea>
            <label class="field__label" for="ContactForm-body">
              {{ 'templates.contact.form.comment' | t }}
            </label>
          </div>

          <button type="submit" class="button button--primary">
            {{ 'templates.contact.form.send' | t }}
          </button>

        {%- endform -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Conatct Us",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Conatct Us"
    }
  ]
}
{% endschema %}
