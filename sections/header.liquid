{% comment %}
  CUSTOM HEADER – XL FEET STYLE
  With Mega Menu (Desktop) and Accordion Menu (Mobile)
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}">

<script src="{{ 'menu-drawer.js' | asset_url }}" defer="defer"></script>

<header class="xl-header section-header">

  <!-- ================= DESKTOP HEADER ================= -->
  <div class="xl-header-desktop">
    <div class="xl-header-top page-width">

      <!-- LOGO -->
      <div class="xl-header-left">
        <a href="{{ routes.root_url }}" class="xl-logo">
          {% if settings.logo %}
            {{ settings.logo | image_url: width: 220 | image_tag: preload: true }}
          {% else %}
            <strong>{{ shop.name }}</strong>
          {% endif %}
        </a>
      </div>

      <!-- SEARCH BAR (Always Visible) -->
      <div class="xl-header-search">
        <form action="{{ routes.search_url }}" method="get" role="search" class="xl-search-form">
          <div class="xl-search-field">
            <span class="xl-search-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </span>
            <input
              type="search"
              name="q"
              placeholder="{{ 'general.search.search' | t }}"
              class="xl-search-input"
              value="{{ search.terms | escape }}"
              autocomplete="off"
            >
            <input type="hidden" name="options[prefix]" value="last">
          </div>
        </form>
      </div>

      <!-- ACCOUNT + CART -->
      <div class="xl-header-right">
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_login_url }}" class="xl-icon">
            <span class="svg-wrapper">
              {{ 'icon-account-1.svg' | inline_asset_content }}
            </span>
            <span>Login / Register</span>
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" class="xl-icon cart-icon">
          <span class="svg-wrapper">
            {{ 'icon-cart-1.svg' | inline_asset_content }}
          </span>
          <span>Cart</span>
        </a>
      </div>

    </div>

    <!-- MENU ROW WITH MEGA MENU -->
    <div class="xl-header-menu">
      <div class="page-width">
        {% if section.settings.menu != blank %}
          <nav class="xl-nav">
            <ul class="xl-menu">
              {% for link in linklists[section.settings.menu].links %}
                <li class="xl-menu-item {% if link.links.size > 0 %}has-dropdown{% endif %} {% if link.title contains 'Clearance' %}clearance{% endif %}">
                  <a href="{{ link.url }}">{{ link.title }}</a>
                  
                  {% if link.links.size > 0 %}
                    <!-- MEGA MENU DROPDOWN -->
                    <div class="xl-mega-menu">
                      <div class="xl-mega-menu-inner">
                        {% for child_link in link.links %}
                          <div class="xl-mega-column {% if child_link.title contains 'Width' %}width-column{% endif %} {% if child_link.title contains 'Size' %}size-column{% endif %} {% if child_link.title contains 'Brand' %}brand-column{% endif %}">
                            <h4 class="xl-mega-title">{{ child_link.title }}</h4>
                            
                            {% if child_link.links.size > 0 %}
                              {% comment %} Check column type and apply different styling {% endcomment %}
                              
                              {% if child_link.title contains 'Width' %}
                                <!-- WIDTH: Pill/Button Style Boxes -->
                                <div class="xl-width-grid">
                                  {% for grandchild_link in child_link.links %}
                                    <a href="{{ grandchild_link.url }}" class="xl-width-box">{{ grandchild_link.title }}</a>
                                  {% endfor %}
                                </div>
                                
                              {% elsif child_link.title contains 'Size' %}
                                <!-- SIZE: Rounded Box Grid -->
                                <div class="xl-size-grid">
                                  {% for grandchild_link in child_link.links %}
                                    <a href="{{ grandchild_link.url }}" class="xl-size-box">{{ grandchild_link.title }}</a>
                                  {% endfor %}
                                </div>
                                
                              {% elsif child_link.title contains 'Brand' %}
                                <!-- BRAND: Image Grid with Logos -->
                                <div class="xl-brand-grid">
                                  {% for grandchild_link in child_link.links %}
                                    <a href="{{ grandchild_link.url }}" class="xl-brand-item">
                                      {% comment %} Try to get brand image from collection or use text {% endcomment %}
                                      {% assign brand_handle = grandchild_link.title | handleize %}
                                      {% assign brand_collection = collections[brand_handle] %}
                                      {% if brand_collection.image %}
                                        {{ brand_collection.image | image_url: width: 100 | image_tag: class: 'xl-brand-logo', alt: grandchild_link.title }}
                                      {% elsif grandchild_link.object.image %}
                                        {{ grandchild_link.object.image | image_url: width: 100 | image_tag: class: 'xl-brand-logo', alt: grandchild_link.title }}
                                      {% else %}
                                        <span class="xl-brand-text">{{ grandchild_link.title }}</span>
                                      {% endif %}
                                    </a>
                                  {% endfor %}
                                </div>
                                <a href="{{ child_link.url }}" class="xl-view-all-link">VIEW ALL <span>→</span></a>
                                
                              {% else %}
                                <!-- DEFAULT: Vertical List -->
                                <ul class="xl-mega-list">
                                  {% for grandchild_link in child_link.links %}
                                    <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
                                  {% endfor %}
                                </ul>
                              {% endif %}
                              
                            {% else %}
                              <a href="{{ child_link.url }}" class="xl-mega-link">View All</a>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- ================= MOBILE HEADER ================= -->
  <div class="xl-header-mobile">
    
    <!-- Hamburger Menu Button -->
    <button class="xl-hamburger" id="mobile-menu-toggle" aria-label="Menu" aria-expanded="false">
      <svg class="icon-hamburger" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="xl-mobile-logo">
      {% if settings.logo %}
        {{ settings.logo | image_url: width: 160 | image_tag: preload: true }}
      {% else %}
        <strong>{{ shop.name }}</strong>
      {% endif %}
    </a>

    <!-- Account + Cart Icons -->
    <div class="xl-mobile-icons">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_login_url }}" class="xl-mobile-icon" aria-label="Account">
          <span class="svg-wrapper">
            {{ 'icon-account-1.svg' | inline_asset_content }}
          </span>
        </a>
      {% endif %}
      <a href="{{ routes.cart_url }}" class="xl-mobile-icon" aria-label="Cart">
        <span class="svg-wrapper">
          {{ 'icon-cart-1.svg' | inline_asset_content }}
        </span>
      </a>
    </div>

  </div>

  <!-- ================= MOBILE MENU DRAWER WITH ACCORDION ================= -->
  <div class="xl-menu-drawer" id="mobile-menu-drawer">
    <div class="xl-drawer-overlay" id="drawer-overlay"></div>
    <div class="xl-drawer-content">
      <div class="xl-drawer-header">
        {{ shop.name }}
        <button class="xl-drawer-close" id="drawer-close" aria-label="Close menu">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <nav class="xl-drawer-nav">
        <ul class="xl-drawer-menu">
          {% for link in linklists[section.settings.menu].links %}
            <li class="xl-drawer-item {% if link.links.size > 0 %}has-children{% endif %}">
              {% if link.links.size > 0 %}
                <!-- Accordion Item with Children -->
                <button class="xl-accordion-toggle" aria-expanded="false">
                  <span>{{ link.title }}</span>
                  <svg class="xl-accordion-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="xl-accordion-content">
                  {% for child_link in link.links %}
                    <div class="xl-accordion-group">
                      {% if child_link.links.size > 0 %}
                        <button class="xl-accordion-sub-toggle" aria-expanded="false">
                          <span>{{ child_link.title }}</span>
                          <svg class="xl-accordion-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 12 15 18 9"></polyline>
                          </svg>
                        </button>
                        <div class="xl-accordion-sub-content">
                          <ul>
                            {% for grandchild_link in child_link.links %}
                              <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% else %}
                        <a href="{{ child_link.url }}" class="xl-accordion-link">{{ child_link.title }}</a>
                      {% endif %}
                    </div>
                  {% endfor %}
                  <a href="{{ link.url }}" class="xl-view-all">View All {{ link.title }}</a>
                </div>
              {% else %}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
      <div class="xl-drawer-footer">
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_login_url }}" class="xl-drawer-link">
            <span class="svg-wrapper">
              {{ 'icon-account-1.svg' | inline_asset_content }}
            </span>
            <span>Login / Register</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

</header>

<style>
/* ===== HEADER BASE ===== */
.xl-header {
  background: #fff;
  border-bottom: 1px solid #e5e5e5;
}

/* ===== DESKTOP / MOBILE TOGGLE ===== */
.xl-header-desktop {
  display: block !important;
}
.xl-header-mobile {
  display: none !important;
}

@media screen and (max-width: 989px) {
  .xl-header-desktop {
    display: none !important;
  }
  .xl-header-mobile {
    display: flex !important;
  }
}

/* ===== DESKTOP: TOP ROW ===== */
.xl-header-top {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 30px;
  padding: 14px 0;
}

/* LOGO */
.xl-header-left {
  display: flex;
  flex-direction: column;
}

.xl-logo img {
  max-height: 50px;
  width: auto;
}

/* SEARCH BAR */
.xl-header-search {
  flex: 1;
  max-width: 520px;
  margin: 0 auto;
  width: 100%;
}

.xl-search-form {
  width: 100%;
}

.xl-search-field {
  position: relative;
  display: flex;
  align-items: center;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
  overflow: hidden;
  padding: 10px 15px;
  gap: 10px;
}

.xl-search-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.xl-search-icon svg {
  width: 22px;
  height: 22px;
}

*:focus-visible {
  box-shadow: unset;
}

.xl-search-input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 14px;
  background: transparent;
  font-family: inherit;
}

.xl-search-input::placeholder {
  color: #999;
}

/* RIGHT ICONS */
.xl-header-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.xl-icon {
  display: flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  font-weight: 500;
  font-family: 'Helvetica Neue', sans-serif;
  color: #191b1d;
  font-size: 14px;
}

.xl-icon .svg-wrapper {
  width: 24px !important;
  height: 24px !important;
}

.xl-icon svg {
  width: 100%;
  height: 100%;
}

/* ===== DESKTOP: MENU ROW ===== */
.xl-header-menu {
  border-top: 1px solid #eee;
  font-weight: 500;
  font-family: 'Helvetica Neue', sans-serif;
  color: #191b1d;
  position: relative;
}
.xl-header-menu .page-width {
 padding:0 !important;
}

.xl-nav {
  position: relative;
}

.xl-menu {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  list-style: none;
  padding: 12px 0;
  margin: 0;
}

.xl-menu > li {
  position: static;
}

.xl-menu > li > a {
  text-decoration: none;
  font-size: 14px;
  color: #000;
  padding: 8px 0;
  display: block;
}

.xl-menu-item.clearance > a {
  background: #ffe08a;
  padding: 6px 14px;
  border-radius: 20px;
  font-weight: 600;
}

/* ===== MEGA MENU (DESKTOP HOVER) ===== */
.xl-mega-menu {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  width: 100%;
  background: #fff;
  border-top: 1px solid #eee;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(10px);
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
  z-index: 1000;
  padding: 30px 0;
}

/* Hide all mega menus by default, show only on hover */
.xl-menu-item.has-dropdown:hover > .xl-mega-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0);
}

/* Ensure hovered menu has higher z-index */
.xl-menu-item.has-dropdown:hover {
  z-index: 1001;
}

.xl-mega-menu-inner {
  display: flex;
  gap: 50px;
  max-width: var(--page-width, 1400px);
  margin: 0 auto;
  padding: 0 50px;
}

/* Mega Menu Columns */
.xl-mega-column {
  flex: 0 0 auto;
  min-width: 180px;
}

.xl-mega-column.width-column {
  min-width: 160px;
}

.xl-mega-column.size-column {
  min-width: 200px;
}

.xl-mega-column.brand-column {
  flex: 1;
  max-width: 350px;
}

.xl-mega-title {
  font-size: 13px;
  font-weight: 700;
  color: #191b1d;
  margin: 0 0 15px 0;
  text-transform: none;
  letter-spacing: 0;
}

/* Default Vertical List */
.xl-mega-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.xl-mega-list li {
  margin-bottom: 8px;
}

.xl-mega-list a {
  color: #555;
  text-decoration: none;
  font-size: 13px;
  font-weight: 400;
  transition: color 0.2s;
}

.xl-mega-list a:hover {
  color: #000;
}

.xl-mega-link {
  color: #555;
  text-decoration: none;
  font-size: 13px;
}

/* ===== SHOP BY WIDTH - Pill/Button Boxes ===== */
.xl-width-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.xl-width-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 16px;
  border: 1px solid #ddd;
  border-radius: 4px;
  background: #fff;
  color: #333;
  font-size: 12px;
  font-weight: 400;
  text-decoration: none;
  transition: all 0.2s ease;
  min-width: 70px;
  text-align: center;
}

.xl-width-box:hover {
  border-color: #000;
  background: #f5f5f5;
}

/* ===== SHOP BY SIZE - Rounded Box Grid ===== */
.xl-size-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.xl-size-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 45px;
  height: 36px;
  border: 1px solid #ddd;
  border-radius: 20px;
  background: #fff;
  color: #333;
  font-size: 12px;
  font-weight: 400;
  text-decoration: none;
  transition: all 0.2s ease;
}

.xl-size-box:hover {
  border-color: #000;
  background: #f5f5f5;
}

/* ===== SHOP BY BRAND - Logo Grid ===== */
.xl-brand-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 15px;
}

.xl-brand-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  border: 1px solid #eee;
  border-radius: 4px;
  background: #fff;
  text-decoration: none;
  transition: all 0.2s ease;
  min-height: 45px;
}

.xl-brand-item:hover {
  border-color: #ccc;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.xl-brand-logo {
  max-width: 70px;
  max-height: 30px;
  object-fit: contain;
}

.xl-brand-text {
  font-size: 10px;
  font-weight: 600;
  color: #333;
  text-align: center;
  text-transform: uppercase;
}

.xl-view-all-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #000;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.xl-view-all-link:hover {
  text-decoration: underline;
}

.xl-view-all-link span {
  font-size: 14px;
}

/* ===== MOBILE HEADER ===== */
.xl-header-mobile {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 7px;
  gap: 10px;
}

.xl-hamburger {
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  color: #191b1d;
}

.xl-hamburger svg {
  width: 24px;
  height: 24px;
}

.xl-mobile-logo {
  flex: 1;
  display: flex;
  justify-content: flex-start;
}

.xl-mobile-logo img {
  max-height: 40px;
  width: auto;
}

.xl-mobile-icons {
  display: flex;
  align-items: center;
  gap: 10px;
}

.xl-mobile-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #191b1d;
  padding: 4px;
}

.xl-mobile-icon svg {
  width: 30px;
  height: 30px;
}

/* ===== MOBILE MENU DRAWER ===== */
.xl-menu-drawer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  visibility: hidden;
  pointer-events: none;
}

.xl-menu-drawer.is-open {
  visibility: visible;
  pointer-events: auto;
}

.xl-drawer-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.xl-menu-drawer.is-open .xl-drawer-overlay {
  opacity: 1;
}

.xl-drawer-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 320px;
  max-width: 85%;
  height: 100%;
  background: #fff;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
}

.xl-menu-drawer.is-open .xl-drawer-content {
  transform: translateX(0);
}

.xl-drawer-header {
  display: flex;
  justify-content: space-between;
  padding: 15px;
  border-bottom: 1px solid #eee;
  align-items: center;
  font-weight: 600;
  font-size: 16px;
}

.xl-drawer-close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  color: #191b1d;
}

.xl-drawer-close svg {
  width: 24px;
  height: 24px;
}

.xl-drawer-nav {
  flex: 1;
  overflow-y: auto;
}

.xl-drawer-menu {
  list-style: none;
  padding: 0;
  margin: 0;
}

.xl-drawer-item {
  border-bottom: 1px solid #f0f0f0;
}

.xl-drawer-item > a {
  display: block;
  padding: 15px 20px;
  text-decoration: none;
  color: #191b1d;
  font-size: 15px;
  font-weight: 500;
  font-family: 'Helvetica Neue', sans-serif;
}

.xl-drawer-item > a:hover {
  background: #f9f9f9;
}

/* ===== ACCORDION STYLES (MOBILE) ===== */
.xl-accordion-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 15px 20px;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 15px;
  font-weight: 500;
  color: #191b1d;
  font-family: 'Helvetica Neue', sans-serif;
  text-align: left;
}

.xl-accordion-toggle:hover {
  background: #f9f9f9;
}

.xl-accordion-icon {
  width: 18px;
  height: 18px;
  transition: transform 0.3s ease;
}

.xl-accordion-toggle[aria-expanded="true"] .xl-accordion-icon {
  transform: rotate(180deg);
}

.xl-accordion-content {
  display: none;
  background: #fafafa;
  padding: 0;
}

.xl-accordion-toggle[aria-expanded="true"] + .xl-accordion-content {
  display: block;
}

.xl-accordion-group {
  border-bottom: 1px solid #eee;
}

.xl-accordion-sub-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 12px 20px 12px 30px;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  font-family: 'Helvetica Neue', sans-serif;
  text-align: left;
}

.xl-accordion-sub-toggle:hover {
  background: #f5f5f5;
}

.xl-accordion-sub-toggle[aria-expanded="true"] .xl-accordion-icon {
  transform: rotate(180deg);
}

.xl-accordion-sub-content {
  display: none;
  background: #f5f5f5;
}

.xl-accordion-sub-toggle[aria-expanded="true"] + .xl-accordion-sub-content {
  display: block;
}

.xl-accordion-sub-content ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.xl-accordion-sub-content li a {
  display: block;
  padding: 10px 20px 10px 45px;
  color: #555;
  text-decoration: none;
  font-size: 13px;
}

.xl-accordion-sub-content li a:hover {
  background: #eee;
  color: #000;
}

.xl-accordion-link {
  display: block;
  padding: 12px 20px 12px 30px;
  color: #333;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
}

.xl-accordion-link:hover {
  background: #f5f5f5;
}

.xl-view-all {
  display: block;
  padding: 12px 20px 12px 30px;
  color: #000;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  border-top: 1px solid #eee;
}

.xl-view-all:hover {
  background: #f5f5f5;
}

.xl-drawer-footer {
  padding: 20px;
  border-top: 1px solid #eee;
}

.xl-drawer-link {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: #191b1d;
  font-size: 14px;
  font-weight: 500;
}

.xl-drawer-link svg {
  width: 20px;
  height: 20px;
}

/* Prevent body scroll when drawer is open */
body.drawer-open {
  overflow: hidden;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menuDrawer = document.getElementById('mobile-menu-drawer');
  const drawerClose = document.getElementById('drawer-close');
  const drawerOverlay = document.getElementById('drawer-overlay');

  // Drawer open/close
  function openDrawer() {
    menuDrawer.classList.add('is-open');
    document.body.classList.add('drawer-open');
    menuToggle.setAttribute('aria-expanded', 'true');
  }

  function closeDrawer() {
    menuDrawer.classList.remove('is-open');
    document.body.classList.remove('drawer-open');
    menuToggle.setAttribute('aria-expanded', 'false');
  }

  if (menuToggle) {
    menuToggle.addEventListener('click', openDrawer);
  }

  if (drawerClose) {
    drawerClose.addEventListener('click', closeDrawer);
  }

  if (drawerOverlay) {
    drawerOverlay.addEventListener('click', closeDrawer);
  }

  // Close drawer on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && menuDrawer.classList.contains('is-open')) {
      closeDrawer();
    }
  });

  // Accordion functionality for mobile menu
  const accordionToggles = document.querySelectorAll('.xl-accordion-toggle');
  accordionToggles.forEach(function(toggle) {
    toggle.addEventListener('click', function() {
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      
      // Close all other accordions at this level
      accordionToggles.forEach(function(otherToggle) {
        if (otherToggle !== toggle) {
          otherToggle.setAttribute('aria-expanded', 'false');
        }
      });
      
      // Toggle current accordion
      this.setAttribute('aria-expanded', !isExpanded);
    });
  });

  // Sub-accordion functionality
  const subAccordionToggles = document.querySelectorAll('.xl-accordion-sub-toggle');
  subAccordionToggles.forEach(function(toggle) {
    toggle.addEventListener('click', function() {
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', !isExpanded);
    });
  });
});
</script>

