{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding:30px 0 30px 10px;
  }
  .collection_grid_section .section-{{ section.id }}-padding{
    padding:30px 10px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
    .collection_grid_section .section-{{ section.id }}-padding {
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }
  .section-{{ section.id }}-padding .page-width {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  /* Custom Featured Collection Styles */
  .fc-section-{{ section.id }} .fc-header {
    display: flex;
    justify-content: space-between;
    /* align-items: flex-start; */
    margin-bottom: 50px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .fc-section-{{ section.id }} .fc-header-left {
    flex: 1;
  }

  .fc-section-{{ section.id }} .fc-header-right {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .fc-section-{{ section.id }} .fc-subtitle {
    font-size: 30px;
    font-family: 'Instrument Serif';
    color: #000;
    margin: 0;
  }

  .fc-section-{{ section.id }} .fc-title {
    font-size: 46px;
    font-weight: 500;
    font-family: 'Helvetica Neue';
    color: #000;
    margin: 0;
    text-align: left;
    }

  .fc-section-{{ section.id }} .fc-view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 50px;
    border: 1px solid #000;
    border-radius: 12px;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    font-family: 'Helvetica Neue';
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }
 
  .fc-section-{{ section.id }} .fc-view-all-btn:hover {
    background: #000;
    color: #fff;
  }

  .fc-section-{{ section.id }} .fc-arrows {
    display: flex;
    gap: 10px;
  }

  .fc-section-{{ section.id }} .fc-arrow {
    width: 40px;
    height: 40px;
    border: 1px solid #ddd;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .fc-section-{{ section.id }} .fc-arrow:hover {
    border-color: #000;
  }

  .fc-section-{{ section.id }} .fc-arrow svg {
    width: 16px;
    height: 16px;
  }

  /* Product Card */
  .fc-section-{{ section.id }} .fc-product-card {
    position: relative;
    flex: 0 0 auto;
  }

  .fc-section-{{ section.id }} .fc-product-image-wrapper {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    border: 0.8px solid #ececec;
    border-radius: 16.27px;
    background-color: rgba(217, 217, 217, 0.15);
  }

  .fc-section-{{ section.id }} .fc-product-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .fc-section-{{ section.id }} .fc-product-image-wrapper:hover .fc-product-image {
    transform: scale(1.05);
  }

  /* Add to Cart Button on Hover */
  .fc-section-{{ section.id }} .fc-add-to-cart-wrapper {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 15px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    z-index: 2;
  }

  .fc-section-{{ section.id }} .fc-product-image-wrapper:hover .fc-add-to-cart-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  .fc-section-{{ section.id }} .fc-add-to-cart-btn {
    width: 100%;
    padding: 12px 20px;
    border: 1px solid #000;
    border-radius: 10px;
    background: #fff;
    color: #000;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .fc-section-{{ section.id }} .fc-add-to-cart-btn:hover {
    background: #000;
    color: #fff;
  }

  .fc-section-{{ section.id }} .fc-add-to-cart-btn.sold-out {
    background: #f5f5f5;
    color: #999;
    border-color: #ddd;
    cursor: not-allowed;
  }

  /* Mobile Add to Cart / Buy Now */
  @media screen and (max-width: 749px) {
     /* Custom Featured Collection Styles */
    .fc-section-{{ section.id }} .fc-header {
      gap:30px;
      margin-bottom: 0;
    }
    .fc-section-{{ section.id }} .fc-subtitle {
      font-size: 22px;
      /* line-height: 18px; */
      text-align: center;
    }
    .fc-section-{{ section.id }} .fc-view-all-btn {
      padding: 10px 30px;
      font-size: 14px;
    } 
    .fc-section-{{ section.id }} .fc-title {
      font-size: 22px;
      line-height: 22px;
      font-weight: 500;
      text-align: center;
      }
      .fc-section-{{ section.id }} .fc-product-price {
      font-size: 14px !important;
      line-height: 14px !important;
      font-weight: 500;
    }
  .fc-section-{{ section.id }} .fc-header-right {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      padding-bottom: 30px;
    }
    .fc-section-{{ section.id }} .fc-add-to-cart-wrapper {
      opacity: 1;
      transform: translateY(0);
      position: relative;
      padding: 10px;
    }

    .fc-section-{{ section.id }} .fc-add-to-cart-btn,
    .fc-section-{{ section.id }} .fc-buy-now-btn {
      padding: 10px 15px;
      font-size: 12px;
    }

    .fc-section-{{ section.id }} .fc-add-to-cart-btn .btn-text,
    .fc-section-{{ section.id }} .fc-buy-now-btn .btn-text {
      display: {% if section.settings.mobile_button_style == 'icon' %}none{% else %}inline{% endif %};
    }

    .fc-section-{{ section.id }} .fc-add-to-cart-btn .btn-icon,
    .fc-section-{{ section.id }} .fc-buy-now-btn .btn-icon {
      display: {% if section.settings.mobile_button_style == 'icon' %}inline{% else %}none{% endif %};
    }
  }

  @media screen and (min-width: 750px) {
    .fc-section-{{ section.id }} .fc-add-to-cart-btn .btn-icon,
    .fc-section-{{ section.id }} .fc-buy-now-btn .btn-icon {
      display: none;
    }
  }

  /* Product Info */
  .fc-section-{{ section.id }} .fc-product-info {
    padding: 20px 0 0;
  }

  .fc-section-{{ section.id }} .fc-product-title {
    font-size: 16px;
    line-height: 20px;
    font-weight: 500;
    font-family: 'Helvetica Neue';
    color: #191b1d;
        margin-bottom: 10px;
    text-decoration: none;
    display: block;
  }
  .fc-section-{{ section.id }} .fc-product-title:hover {
      text-decoration: underline;
        }
  .fc-section-{{ section.id }} .fc-product-vendor {
    font-size: 12px;
    color: #888;
    margin-bottom: 10px;
  }
   .fc-section-{{ section.id }} .fc-product-type {
    font-size: 12px;
    line-height: 12px;
    font-weight: 500;
    font-family: 'Helvetica Neue';
    color: #666;
    text-align: left;
    margin: 0 0 10px 0;
  }

  .fc-section-{{ section.id }} .fc-product-price {
    font-size: 16px;
    line-height: 16px;
    color: #191b1d;
    font-weight: 500;
    font-family: 'Helvetica Neue';
    margin: 0;
  }

  .fc-section-{{ section.id }} .fc-product-rating {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: #666;
    margin-top: 5px;
  }

  /* Variant Swatches */
  .fc-section-{{ section.id }} .fc-variant-swatches {
    display: flex;
    gap: 6px;
    padding-top: 20px;
    flex-wrap: wrap;
  }

  .fc-section-{{ section.id }} .fc-swatch {
    width: 45px;
    height: 45px;
    border-radius: 4px;
    border: 1px solid #ddd;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s;
    padding: 0;
    background: none;
  }

  .fc-section-{{ section.id }} .fc-swatch:hover,
  .fc-section-{{ section.id }} .fc-swatch.active {
    border-color: #000;
  }

  .fc-section-{{ section.id }} .fc-swatch img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fc-section-{{ section.id }} .fc-swatch-color {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Grid Layout (when carousel disabled) */
  .fc-section-{{ section.id }} .fc-products-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
  }

  /* Slider Layout (when carousel enabled) */
  .fc-section-{{ section.id }} .fc-products-slider {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    user-select: none;
  }

  .fc-section-{{ section.id }} .fc-products-slider::-webkit-scrollbar {
    display: none;
  }

  .fc-section-{{ section.id }} .fc-products-slider.dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  /* Secondary Image on Hover */
  .fc-section-{{ section.id }} .fc-product-image-secondary {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .fc-section-{{ section.id }} .fc-product-image-primary {
    transition: opacity 0.3s ease, transform 0.3s ease;
    position: relative;
    z-index: 0;
  }

  /* Show secondary image when hovering on image link only */
  .fc-section-{{ section.id }} .fc-product-link:hover .fc-product-image-secondary {
    opacity: 1;
  }

  .fc-section-{{ section.id }} .fc-product-link:hover .fc-product-image-primary {
    opacity: 0;
  }

  /* When hovering on button area, show primary image */
  .fc-section-{{ section.id }} .fc-add-to-cart-wrapper:hover ~ .fc-product-link .fc-product-image-primary,
  .fc-section-{{ section.id }} .fc-product-image-wrapper:has(.fc-add-to-cart-wrapper:hover) .fc-product-image-primary {
    opacity: 1;
  }

  .fc-section-{{ section.id }} .fc-add-to-cart-wrapper:hover ~ .fc-product-link .fc-product-image-secondary,
  .fc-section-{{ section.id }} .fc-product-image-wrapper:has(.fc-add-to-cart-wrapper:hover) .fc-product-image-secondary {
    opacity: 0;
  }

  /* Buy Now Button */
  .fc-section-{{ section.id }} .fc-buy-now-btn {
    width: 100%;
    padding: 12px 20px;
    border: 1px solid #000;
    border-radius: 10px;
    background: #fff;
    color: #000;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .fc-section-{{ section.id }} .fc-buy-now-btn:hover {
    background: #000;
    color: #fff;
  }

  .fc-section-{{ section.id }} .fc-products-slider .fc-product-card {
    width: calc((100% - 60px) / {{ section.settings.columns_desktop }});
    min-width: 250px;
  }

  @media screen and (max-width: 989px) {
    .fc-section-{{ section.id }} .fc-products-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .fc-section-{{ section.id }} .fc-products-slider .fc-product-card {
      width: calc((100% - 20px) / 2);
      min-width: 200px;
    }
  }

  @media screen and (max-width: 749px) {

     .fc-section-{{ section.id }} .fc-swatch {
      width: 30px !important;
      height: 30px !important;
    }

    .fc-section-{{ section.id }} .fc-products-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 15px;
    }

    .fc-section-{{ section.id }} .fc-products-slider .fc-product-card {
      width: 70%;
      min-width: 180px;
    }

    .fc-section-{{ section.id }} .fc-header {
      flex-direction: column;
    }

    .fc-section-{{ section.id }} .fc-title {
      font-size: 22px;
      line-height: 22px;
      font-weight: 500;
    }

    .fc-section-{{ section.id }} .fc-arrows {
      display: none;
    }
  }

  /* Hide default slider buttons */
  .fc-section-{{ section.id }} .slider-buttons {
    display: none !important;
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.collection.all_products_count

  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and products_to_display > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and products_to_display > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }} isolate gradient fc-section-{{ section.id }}">
  <div class="collection section-{{ section.id }}-padding " id="collection-{{ section.id }}" data-id="{{ section.id }}">
    <div class="page-width">
    <!-- Header with Title and View All / Arrows -->
    <div class="fc-header">
      <div class="fc-header-left">
        {%- if section.settings.description != blank or section.settings.show_description and section.settings.collection.description != empty -%}
          <p class="fc-subtitle">
            {%- if section.settings.show_description -%}
              {{ section.settings.collection.description | strip_html }}
            {%- else -%}
              {{ section.settings.description | strip_html }}
            {%- endif -%}
          </p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="fc-title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
      
      <div class="fc-header-right">
        {%- if section.settings.show_view_all and section.settings.collection != blank and more_in_collection -%}
          <a href="{{ section.settings.show_view_all_url }}" class="fc-view-all-btn">
            {{ section.settings.view_all_text | default: 'View All' }}  
            <span class="svg-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
                </span>
          </a>
        {%- endif -%}
        
        {%- if section.settings.enable_desktop_slider -%}
          <div class="fc-arrows">
            <button type="button" class="fc-arrow fc-arrow-prev" aria-label="Previous" data-slider-prev="{{ section.id }}">
              <span class="svg-wrapper">
            {{ 'icon-arrow-left.svg' | inline_asset_content }}
          </span>
            </button>
            <button type="button" class="fc-arrow fc-arrow-next" aria-label="Next" data-slider-next="{{ section.id }}">
              <span class="svg-wrapper">
            {{ 'icon-arrow-right.svg' | inline_asset_content }}
          </span>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Products Grid or Slider -->
    <div class="{% if section.settings.enable_desktop_slider %}fc-products-slider{% else %}fc-products-grid{% endif %}" id="fc-container-{{ section.id }}">
      {%- if section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <div class="fc-product-card" data-product-id="{{ product.id }}">
            <div class="fc-product-image-wrapper">
              <!-- Product Image -->
              <a href="{{ product.url }}" class="fc-product-link">
                {% if product.featured_image %}
                  <img 
                    src="{{ product.featured_image | image_url: width: 600 }}" 
                    alt="{{ product.title | escape }}"
                    class="fc-product-image fc-product-image-primary"
                    id="fc-image-{{ section.id }}-{{ product.id }}"
                    loading="lazy"
                    draggable="false"
                  >
                  {%- if section.settings.show_secondary_image and product.images[1] != blank -%}
                    <img 
                      src="{{ product.images[1] | image_url: width: 600 }}" 
                      alt="{{ product.title | escape }}"
                      class="fc-product-image fc-product-image-secondary"
                      loading="lazy"
                      draggable="false"
                    >
                  {%- endif -%}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'fc-product-image' }}
                {% endif %}
              </a>
              
              <!-- Add to Cart / Buy Now on Hover -->
              {%- if section.settings.button_type != 'none' -%}
                <div class="fc-add-to-cart-wrapper">
                  {%- if product.available -%}
                    {%- if section.settings.button_type == 'add_to_cart' -%}
                      <form action="/cart/add" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" id="fc-variant-{{ section.id }}-{{ product.id }}" value="{{ product.selected_or_first_available_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="fc-add-to-cart-btn">
                          <span class="btn-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <circle cx="9" cy="21" r="1"></circle>
                              <circle cx="20" cy="21" r="1"></circle>
                              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                          </span>
                          <span class="btn-text">{{ section.settings.add_to_cart_text | default: 'Add to Cart' }}</span>
                        </button>
                      </form>
                    {%- elsif section.settings.button_type == 'buy_now' -%}
                      <button type="button" class="fc-buy-now-btn" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-fc-buy-now>
                        <span class="btn-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                          </svg>
                        </span>
                        <span class="btn-text">{{ section.settings.buy_now_text | default: 'Buy Now' }}</span>
                      </button>
                      <input type="hidden" id="fc-variant-{{ section.id }}-{{ product.id }}" value="{{ product.selected_or_first_available_variant.id }}">
                    {%- endif -%}
                  {%- else -%}
                    <button class="fc-add-to-cart-btn sold-out" disabled>
                      <span class="btn-text">Sold Out</span>
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
            
            <!-- Product Info -->
            <div class="fc-product-info">
              <a href="{{ product.url }}" class="fc-product-title" id="fc-title-{{ section.id }}-{{ product.id }}">{{ product.title }}</a>
              
               {%- if section.settings.show_type -%}
                <p class="fc-product-type">{{ product.type }}</p>
              {%- endif -%}

              {%- if section.settings.show_vendor -%}
                <p class="fc-product-vendor">{{ product.vendor }}</p>
              {%- endif -%}
              
              <p class="fc-product-price" id="fc-price-{{ section.id }}-{{ product.id }}">
                {% if product.compare_at_price > product.price %}
                  <span style="text-decoration: line-through; color: #999; margin-right: 8px;">{{ product.compare_at_price | money }}</span>
                {% endif %}
                {{ product.price | money }}
              </p>
              
              {%- if section.settings.show_rating and product.metafields.reviews.rating.value != blank -%}
                <div class="fc-product-rating">
                  <span>★</span>
                  <span>{{ product.metafields.reviews.rating.value }}</span>
                </div>
              {%- endif -%}
              
              <!-- Variant Swatches - Click to update product data -->
              {%- if section.settings.show_variant_swatches -%}
                {%- assign color_option = nil -%}
                {%- assign color_option_index = nil -%}
                {%- for option in product.options_with_values -%}
                  {%- assign option_name_lower = option.name | downcase -%}
                  {%- if option_name_lower == 'color' or option_name_lower == 'colour' -%}
                    {%- assign color_option = option -%}
                    {%- assign color_option_index = forloop.index0 -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                
                {%- if color_option -%}
                  <div class="fc-variant-swatches" data-product-id="{{ product.id }}" data-section-id="{{ section.id }}">
                    {%- for value in color_option.values limit: 5 -%}
                      {%- assign variant_for_value = nil -%}
                      {%- assign variant_image = nil -%}
                      {%- for variant in product.variants -%}
                        {%- case color_option_index -%}
                          {%- when 0 -%}
                            {%- if variant.option1 == value -%}
                              {%- assign variant_for_value = variant -%}
                              {%- if variant.image -%}
                                {%- assign variant_image = variant.image -%}
                              {%- endif -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- when 1 -%}
                            {%- if variant.option2 == value -%}
                              {%- assign variant_for_value = variant -%}
                              {%- if variant.image -%}
                                {%- assign variant_image = variant.image -%}
                              {%- endif -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- when 2 -%}
                            {%- if variant.option3 == value -%}
                              {%- assign variant_for_value = variant -%}
                              {%- if variant.image -%}
                                {%- assign variant_image = variant.image -%}
                              {%- endif -%}
                              {%- break -%}
                            {%- endif -%}
                        {%- endcase -%}
                      {%- endfor -%}
                      
                      <button 
                        type="button" 
                        class="fc-swatch{% if forloop.first %} active{% endif %}" 
                        title="{{ value }}"
                        data-variant-id="{{ variant_for_value.id }}"
                        data-variant-price="{{ variant_for_value.price | money }}"
                        data-variant-image="{% if variant_image %}{{ variant_image | image_url: width: 600 }}{% endif %}"
                        data-variant-available="{{ variant_for_value.available }}"
                      >
                        {%- if variant_image -%}
                          <img src="{{ variant_image | image_url: width: 60 }}" alt="{{ value }}">
                        {%- else -%}
                          <span class="fc-swatch-color" style="background-color: {{ value | handleize }};"></span>
                        {%- endif -%}
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="fc-product-card">
            <div class="fc-product-image-wrapper">
              {% liquid
                assign ridx = forloop.rindex
                case ridx
                  when 5
                    assign ridx = 1
                  when 6
                    assign ridx = 2
                endcase
              %}
              {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
              {{ placeholder_image | placeholder_svg_tag: 'fc-product-image' }}
            </div>
            <div class="fc-product-info">
              <p class="fc-product-title">Example Product Title</p>
              <p class="fc-product-price">$99.99</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const container = document.getElementById('fc-container-' + sectionId);
  
  if (!container) return;

  // Mouse click and drag slider functionality
  {%- if section.settings.enable_desktop_slider -%}
  let isDown = false;
  let startX;
  let scrollLeft;
  let hasMoved = false;

  container.addEventListener('mousedown', (e) => {
    isDown = true;
    hasMoved = false;
    container.classList.add('dragging');
    startX = e.pageX - container.offsetLeft;
    scrollLeft = container.scrollLeft;
  });

  container.addEventListener('mouseleave', () => {
    if (isDown) {
      isDown = false;
      container.classList.remove('dragging');
    }
  });

  container.addEventListener('mouseup', (e) => {
    isDown = false;
    container.classList.remove('dragging');
    
    if (hasMoved) {
      e.preventDefault();
    }
  });

  container.addEventListener('mousemove', (e) => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - container.offsetLeft;
    const walk = (x - startX) * 1.5;
    
    if (Math.abs(walk) > 5) {
      hasMoved = true;
    }
    
    container.scrollLeft = scrollLeft - walk;
  });

  // Prevent link clicks when dragging
  container.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', (e) => {
      if (hasMoved) {
        e.preventDefault();
        hasMoved = false;
      }
    });
  });

  // Arrow buttons
  const prevBtn = document.querySelector('[data-slider-prev="{{ section.id }}"]');
  const nextBtn = document.querySelector('[data-slider-next="{{ section.id }}"]');
  const cardWidth = container.querySelector('.fc-product-card')?.offsetWidth + 20 || 300;

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      container.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      container.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });
  }
  {%- endif -%}

  // Handle image switching on button hover - show primary image when hovering on button
  const productCards = document.querySelectorAll('.fc-section-' + sectionId + ' .fc-product-card');
  
  productCards.forEach(card => {
    const buttonWrapper = card.querySelector('.fc-add-to-cart-wrapper');
    const primaryImage = card.querySelector('.fc-product-image-primary');
    const secondaryImage = card.querySelector('.fc-product-image-secondary');
    
    if (buttonWrapper && primaryImage && secondaryImage) {
      buttonWrapper.addEventListener('mouseenter', () => {
        primaryImage.style.opacity = '1';
        secondaryImage.style.opacity = '0';
      });
      
      buttonWrapper.addEventListener('mouseleave', () => {
        primaryImage.style.opacity = '';
        secondaryImage.style.opacity = '';
      });
    }
  });

  // Buy Now button - Add to cart and redirect to checkout
  const buyNowButtons = document.querySelectorAll('.fc-section-' + sectionId + ' [data-fc-buy-now]');
  
  buyNowButtons.forEach(btn => {
    btn.addEventListener('click', async function(e) {
      e.preventDefault();
      
      const card = this.closest('.fc-product-card');
      const productId = card.dataset.productId;
      const variantInput = card.querySelector('[id^="fc-variant-"]');
      const variantId = variantInput ? variantInput.value : this.dataset.variantId;
      
      // Disable button and show loading
      this.disabled = true;
      const btnText = this.querySelector('.btn-text');
      const originalText = btnText.textContent;
      btnText.textContent = 'Processing...';
      
      try {
        // Add to cart via AJAX
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        });
        
        if (response.ok) {
          // Redirect to checkout
          window.location.href = '/checkout';
        } else {
          throw new Error('Failed to add to cart');
        }
      } catch (error) {
        console.error('Error:', error);
        btnText.textContent = 'Error';
        setTimeout(() => {
          btnText.textContent = originalText;
          this.disabled = false;
        }, 2000);
      }
    });
  });

  // Variant swatch click - update product data without redirect
  const swatchContainers = document.querySelectorAll('.fc-section-' + sectionId + ' .fc-variant-swatches');
  
  swatchContainers.forEach(swatchContainer => {
    const productId = swatchContainer.dataset.productId;
    const secId = swatchContainer.dataset.sectionId;
    const swatches = swatchContainer.querySelectorAll('.fc-swatch');
    
    swatches.forEach(swatch => {
      swatch.addEventListener('click', function() {
        // Remove active from all swatches
        swatches.forEach(s => s.classList.remove('active'));
        // Add active to clicked swatch
        this.classList.add('active');
        
        const variantId = this.dataset.variantId;
        const variantPrice = this.dataset.variantPrice;
        const variantImage = this.dataset.variantImage;
        const variantAvailable = this.dataset.variantAvailable === 'true';
        
        // Update image
        if (variantImage) {
          const imageEl = document.getElementById('fc-image-' + secId + '-' + productId);
          if (imageEl) {
            imageEl.src = variantImage;
          }
        }
        
        // Update price
        const priceEl = document.getElementById('fc-price-' + secId + '-' + productId);
        if (priceEl && variantPrice) {
          priceEl.innerHTML = variantPrice;
        }
        
        // Update hidden variant input
        const variantInput = document.getElementById('fc-variant-' + secId + '-' + productId);
        if (variantInput) {
          variantInput.value = variantId;
        }
        
        // Update add to cart / buy now button availability
        const card = this.closest('.fc-product-card');
        const addToCartBtn = card.querySelector('.fc-add-to-cart-btn');
        const buyNowBtn = card.querySelector('.fc-buy-now-btn');
        const wrapper = card.querySelector('.fc-add-to-cart-wrapper');
        
        if (variantAvailable) {
          if (addToCartBtn && !addToCartBtn.classList.contains('sold-out')) {
            addToCartBtn.disabled = false;
            addToCartBtn.classList.remove('sold-out');
            const btnText = addToCartBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = '{{ section.settings.add_to_cart_text | default: "Add to Cart" }}';
          }
          if (buyNowBtn) {
            buyNowBtn.disabled = false;
            buyNowBtn.dataset.variantId = variantId;
            const btnText = buyNowBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = '{{ section.settings.buy_now_text | default: "Buy Now" }}';
          }
        } else {
          // Show sold out
          if (addToCartBtn) {
            addToCartBtn.disabled = true;
            addToCartBtn.classList.add('sold-out');
            const btnText = addToCartBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'Sold Out';
          }
          if (buyNowBtn) {
            buyNowBtn.disabled = true;
            const btnText = buyNowBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'Sold Out';
          }
        }
      });
    });
  });
});
</script>

