{% style %}
 .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    }
}
.bottom-feature-grid-{{ section.id }} {
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
}

.bottom-feature-grid-{{ section.id }} .section-header {
  text-align: center;
  max-width: 820px;
  margin: 0 auto 3rem;
}

.bottom-feature-grid-{{ section.id }} .pill-buttons {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}

.bottom-feature-grid-{{ section.id }} .pill {
  padding: 8px 18px;
  border-radius: 999px;
  border: 1px solid rgba(var(--color-foreground), 0.2);
  font-size: 14px;
  font-weight: 500;
}

.bottom-feature-grid-{{ section.id }} .grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

.bottom-feature-grid-{{ section.id }} .card {
  background: rgb(var(--color-background));
  border-radius: 12px;
  overflow: hidden;
}

.bottom-feature-grid-{{ section.id }} .card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
}

.bottom-feature-grid-{{ section.id }} .card-content {
  padding: 1rem;
}

.bottom-feature-grid-{{ section.id }} .card-content h3 {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.bottom-feature-grid-{{ section.id }} .card-content p {
  font-size: 14px;
  opacity: 0.8;
}
.comp_heighlight_heading {
    max-width: max-content;
    margin: auto auto 30px;
    background: #F4F4F4;
    border-radius: 20px;
    padding: 18px 28px;
    display: flex;
    align-items: center;
    gap: 20px;
    font-weight: 500;
    font-size: 16px;
}
.comp_heighlight_heading img{
    max-width:50px;
    width:100%;
}
@media screen and (max-width: 989px) {
  .bottom-feature-grid-{{ section.id }} .grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (max-width: 749px) {
  .bottom-feature-grid-{{ section.id }} .grid {
    grid-template-columns: 1fr;
  }
}
{% endstyle %}

<section class="bottom-feature-grid-{{ section.id }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">

    <div class="section-header">
    <div>
        <div class="comp_heighlight_heading">
           {% if section.settings.heading_img !=blank %} <img src="{{ section.settings.heading_img | img_url  : 'master' }}"> {% endif %}
            <span>
                {{ section.settings.company_heading }}
            </span>
        </div>
    </div>
      {% if section.settings.show_pills %}
        <div class="pill-buttons">
          {% for block in section.blocks %}
        {% if block.settings.year  %}
          <div class="block-{{block.id }} custom_timeline_block">
            <div class="timeline-item color-{{ block.settings.block_color_scheme }}">
                <h2>{{ block.settings.year }}</h2>
            </div>
            <span>{{ block.settings.description }}</span>
            </div>
        {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="grid">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          <div class="card">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 600 | image_tag }}
            {% endif %}
            <div class="card-content">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Company Highlights",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "image_picker",
      "id": "heading_img",
      "label": "Heading Image"
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "Heading",
      "default": "Our Journey & Presence"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our story, stores, team, and commitment to quality."
    },
    {
      "type": "checkbox",
      "id": "show_pills",
      "label": "Show pill buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill Button",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "1990"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Age 7, Size 7"
        },
        {
            "type": "color_scheme",
            "id": "block_color_scheme",
           "label": "Block Color Scheme"
        }
      ]
    },
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Short description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Company Highlights",
      "blocks": [
        { "type": "pill" },
        { "type": "pill" },
        { "type": "pill" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
