{% comment %}
  Bottom Image Cards
  - Reusable 2-up (or 1–4) image card grid with overlay text + CTA
  - Use at the bottom of pages/collections/products
{% endcomment %}

<section class="bottom-image-cards color-{{ section.settings.color_scheme }}{% if section.settings.remove_top_spacing %} remove-top{% endif %}{% if section.settings.remove_bottom_spacing %} remove-bottom{% endif %}">
  <div class="page-width">
    {% if section.settings.heading or section.settings.subheading %}
      <div class="section-header">
        {% if section.settings.subheading != blank %}
          <p class="subheading">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="cards-grid" style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-tablet: {{ section.settings.columns_tablet }}; --card-height: {{ section.settings.card_height }}px;">
      {% for block in section.blocks %}
        {% assign b = block.settings %}
        <article class="card" {{ block.shopify_attributes }}>
          {% if b.image != blank %}
            {{ b.image | image_url: width: 1400 | image_tag:
              widths: '400, 600, 800, 1000, 1400',
              sizes: '(min-width: 990px) 50vw, (min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: b.title | escape
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder' }}
          {% endif %}

          <div class="card-overlay"></div>

          <div class="card-content">
            {% if b.eyebrow != blank %}
              <span class="eyebrow">{{ b.eyebrow }}</span>
            {% endif %}
            {% if b.title != blank %}
              <h3 class="title">{{ b.title }}</h3>
            {% endif %}
            {% if b.link_url != blank and b.link_label != blank %}
              <a class="cta" href="{{ b.link_url }}" {% if b.open_in_new %}target="_blank" rel="noopener"{% endif %}>{{ b.link_label }}</a>
            {% endif %}
          </div>

          {% if b.link_url != blank and b.card_is_link %}
            <a class="stretched-link" href="{{ b.link_url }}" aria-label="{{ b.title | default: b.link_label | escape }}" {% if b.open_in_new %}target="_blank" rel="noopener"{% endif %}></a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>

  <style>
    /* Scoped to this section instance */
    #shopify-section-{{ section.id }} .bottom-image-cards {
      padding: 48px 0;
    }
    #shopify-section-{{ section.id }} .bottom-image-cards.remove-top { padding-top: 0; }
    #shopify-section-{{ section.id }} .bottom-image-cards.remove-bottom { padding-bottom: 0; }

    #shopify-section-{{ section.id }} .section-header {
      text-align: center;
      margin-bottom: 24px;
    }
    #shopify-section-{{ section.id }} .section-header .subheading {
      margin: 0 0 6px;
      opacity: .75;
      letter-spacing: .04em;
      text-transform: uppercase;
      font-size: 12px;
    }
    #shopify-section-{{ section.id }} .section-header .heading {
      margin: 0;
      font-size: 28px;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .cards-grid {
      display: grid;
      grid-template-columns: repeat(var(--cols-desktop, 2), minmax(0, 1fr));
      gap: 16px;
    }
    @media (max-width: 989px) {
      #shopify-section-{{ section.id }} .cards-grid {
        grid-template-columns: repeat(var(--cols-tablet, 2), minmax(0, 1fr));
      }
    }
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .cards-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }
    }

    #shopify-section-{{ section.id }} .card {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      isolation: isolate;
      height: var(--card-height, 280px);
      background: #f6f6f6;
    }
    #shopify-section-{{ section.id }} .card img,
    #shopify-section-{{ section.id }} .card svg.placeholder {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    #shopify-section-{{ section.id }} .card-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0) 20%, rgba(0,0,0,.55) 80%);
      z-index: 1;
    }
    #shopify-section-{{ section.id }} .card-content {
      position: absolute;
      inset-inline: 14px;
      bottom: 14px;
      z-index: 2;
      color: #ffffff;
      display: grid;
      gap: 6px;
    }
    #shopify-section-{{ section.id }} .eyebrow {
      align-self: start;
      display: inline-block;
      padding: 4px 8px;
      font-size: 11px;
      letter-spacing: .04em;
      text-transform: uppercase;
      border-radius: 999px;
      background: rgba(255,255,255,.14);
      backdrop-filter: saturate(120%) blur(2px);
    }
    #shopify-section-{{ section.id }} .title {
      margin: 0;
      font-size: 18px;
      line-height: 1.25;
      font-weight: 600;
    }
    #shopify-section-{{ section.id }} .cta {
      color: #ffffff;
      font-size: 13px;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    #shopify-section-{{ section.id }} .stretched-link {
      position: absolute;
      inset: 0;
      z-index: 3;
      text-indent: -9999px;
    }
  </style>
</section>

{% schema %}
{
  "name": "Company Highlights",
  "tag": "section",
  "class": "section bottom-image-cards",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Explore more" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "background-1",
      "options": [
        { "value": "background-1", "label": "Default" },
        { "value": "background-2", "label": "Inverse" }
      ]
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_tablet", "label": "Columns on tablet", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "card_height", "label": "Card height (px)", "min": 160, "max": 420, "step": 10, "default": 280 },
    { "type": "checkbox", "id": "remove_top_spacing", "label": "Remove top spacing", "default": false },
    { "type": "checkbox", "id": "remove_bottom_spacing", "label": "Remove bottom spacing", "default": false }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image card",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Small label (optional)", "default": "Featured" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "url", "id": "link_url", "label": "Link URL" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "checkbox", "id": "card_is_link", "label": "Make entire card clickable", "default": true },
        { "type": "checkbox", "id": "open_in_new", "label": "Open link in new tab", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Company Highlights",
      "category": "Image",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}