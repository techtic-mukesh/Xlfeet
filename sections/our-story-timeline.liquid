{{ 'section-our-story-timeline.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 20px;
    padding-right: 20px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }

  .story-timeline-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }

  .story-timeline-{{ section.id }} .story-header-title {
    color: {{ section.settings.title_color }};
  }

  .story-timeline-{{ section.id }} .timeline-year {
    color: {{ section.settings.year_color }};
    border-color: {{ section.settings.year_border_color }};
  }

  .story-timeline-{{ section.id }} .timeline-description {
    color: {{ section.settings.description_color }};
  }

  .story-timeline-{{ section.id }} .story-content p {
    color: {{ section.settings.content_color }};
  }

  .story-timeline-{{ section.id }} .image-card-text {
    color: {{ section.settings.image_text_color }};
    background: {{ section.settings.image_overlay_color }};
  }
{%- endstyle -%}

<div class="story-timeline-section story-timeline-{{ section.id }} section-{{ section.id }}-padding">
  <!-- Header -->
  {% if section.settings.show_header %}
    <div class="story-header">
      <div class="story-header-badge">
        {% if section.settings.header_icon != blank %}
          <img src="{{ section.settings.header_icon | image_url: width: 60 }}" alt="Icon" class="header-icon" loading="lazy">
        {% else %}
          <svg class="header-icon-svg" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {% endif %}
        <span class="story-header-title">{{ section.settings.header_title }}</span>
      </div>
    </div>
  {% endif %}

  <!-- Timeline -->
  {% assign year_blocks = section.blocks | where: "type", "year" %}
  {% if year_blocks.size > 0 %}
    <div class="timeline-container">
      <div class="timeline-line"></div>
      <div class="timeline-years">
        {% for block in year_blocks %}
          <div class="timeline-item" {{ block.shopify_attributes }}>
            <div class="timeline-year">{{ block.settings.year }}</div>
            <div class="timeline-dot"></div>
            <div class="timeline-description">{{ block.settings.description }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- Story Content -->
  {% if section.settings.content != blank %}
    <div class="story-content">
      {{ section.settings.content }}
    </div>
  {% endif %}

  <!-- Image Cards -->
  {% assign image_blocks = section.blocks | where: "type", "image_card" %}
  {% if image_blocks.size > 0 %}
    <div class="image-cards-container">
      <div class="image-cards-wrapper">
        {% for block in image_blocks %}
          <div class="image-card" {{ block.shopify_attributes }}>
            <div class="image-card-inner">
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image_alt | default: block.settings.caption }}"
                  class="image-card-img"
                  loading="lazy"
                  width="600"
                  height="400"
                >
              {% else %}
                <div class="image-card-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
              {% if block.settings.caption != blank %}
                <div class="image-card-text">
                  <p>{{ block.settings.caption }}</p>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Our Story Timeline",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Header",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "header_icon",
      "label": "Header Icon"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Header Title",
      "default": "EXPERTFIT® CONSULTATION OVER THE NET"
    },
    {
      "type": "header",
      "content": "Story Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Story Content",
      "default": "<p>Add your story content here. You can add multiple paragraphs to tell your brand story.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Header Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "year_color",
      "label": "Year Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "year_border_color",
      "label": "Year Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Year Description Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "image_text_color",
      "label": "Image Card Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "Image Card Overlay Color",
      "default": "rgba(0, 0, 0, 0.5)"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Left Padding (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Right Padding (Desktop)",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "year",
      "name": "Timeline Year",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2008"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Started xlfeet in back room of his house"
        }
      ]
    },
    {
      "type": "image_card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption",
          "default": "Adrian's Home where XLFeet began out of a spare bedroom."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story Timeline",
      "blocks": [
        {
          "type": "year",
          "settings": {
            "year": "2008",
            "description": "Started xlfeet in back room of his house"
          }
        },
        {
          "type": "year",
          "settings": {
            "year": "2010",
            "description": "provided the shoe store experience from xlfeetmobile;"
          }
        },
        {
          "type": "year",
          "settings": {
            "year": "2012",
            "description": "Added Florsheim Brand after receiving $1K microgrant"
          }
        },
        {
          "type": "image_card",
          "settings": {
            "caption": "Adrian's Home where XLFeet began out of a spare bedroom."
          }
        },
        {
          "type": "image_card",
          "settings": {
            "caption": "Photo light box for manually creating product images for the website."
          }
        },
        {
          "type": "image_card",
          "settings": {
            "caption": "The van Adrian believed would deliver his store to the customer's door."
          }
        },
        {
          "type": "image_card",
          "settings": {
            "caption": "Adrian's tablet for accepting mobile payments."
          }
        }
      ]
    }
  ]
}
{% endschema %}

