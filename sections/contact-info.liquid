{% comment %}
  Section: Contact Info Grid (Dawn compatible)
  CMS: Color scheme, padding, blocks with icon, title, text
{% endcomment %}

{{ 'section-contact-info-grid.css' | asset_url | stylesheet_tag }}

<section class="contact-info-grid color-{{ section.settings.color_scheme }} section-{{ section.id }}">
  <div class="page-width">
    <div class="contact-info-grid__wrapper">
      {% for block in section.blocks %}
        <div class="contact-info-grid__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="contact-info-grid__icon">
              {{ block.settings.icon | image_url: width: 60 | image_tag: loading: 'lazy' }}
            </div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h3 class="contact-info-grid__heading">{{ block.settings.heading }}</h3>
          {% endif %}

          {% if block.settings.content != blank %}
            <div class="contact-info-grid__content rte">
              {{ block.settings.content }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
.section-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Contact info grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step":4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "CONTACT US"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>(555) 123-4567<br>hello@example.com</p>"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Contact info grid",
      "blocks": [
        { "type": "info" },
        { "type": "info" },
        { "type": "info" }
      ]
    }
  ]
}
{% endschema %}
