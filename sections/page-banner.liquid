{% style %}
.page-banner-{{ section.id }} {
  position: relative;
  width: 100%;
}

.page-banner-{{ section.id }} picture,
.page-banner-{{ section.id }} img {
  width: 100%;
  height: auto;
  display: block;
}

.page-banner-{{ section.id }} .overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    {{ section.settings.gradient_direction }},
    {{ section.settings.gradient_color }} {{ section.settings.gradient_opacity }}%,
    {{ section.settings.gradient_color_2 }} {{ section.settings.gradient_opacity_2 }}%
  );
}

.page-banner-{{ section.id }} .content {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
}

.page-banner-{{ section.id }} h1 {
  color: {{ section.settings.title_color }};
  font-size: clamp(26px, 5vw, 48px);
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin: 0;
}
{% endstyle %}

<section class="page-banner-{{ section.id }}">
  <picture>
    {% if section.settings.mobile_image %}
      <source
        media="(max-width: 749px)"
        srcset="{{ section.settings.mobile_image | image_url }}">
    {% endif %}

    {% if section.settings.desktop_image %}
      <img
        src="{{ section.settings.desktop_image | image_url }}"
        alt="{{ page.title }}"
        loading="lazy">
    {% endif %}
  </picture>

  <div class="overlay"></div>

  <div class="content">
    <div class="page-width">
      <h1>
        {{ page.title | default: collection.title | default: product.title }}
      </h1>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Banner (Clean IMG)",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient Direction",
      "options": [
        { "value": "to right", "label": "Left → Right" },
        { "value": "to left", "label": "Right → Left" },
        { "value": "to bottom", "label": "Top → Bottom" },
        { "value": "to top", "label": "Bottom → Top" }
      ],
      "default": "to right"
    },
    {
      "type": "color",
      "id": "gradient_color",
      "label": "Gradient Color 1",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "label": "Gradient Opacity 1 (%)",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient Color 2",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "gradient_opacity_2",
      "label": "Gradient Opacity 2 (%)",
      "min": 0,
      "max": 100,
      "default": 0
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Page Banner"
    }
  ]
}
{% endschema %}
