{% style %}
.text-video-{{ section.id }} {
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
}

.text-video-{{ section.id }} .wrapper {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.text-video-{{ section.id }} .grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

@media (max-width: 749px) {
  .text-video-{{ section.id }} .grid {
    grid-template-columns: 1fr;
  }
}

.text-video-{{ section.id }} h2 {
  font-size: clamp(24px, 3vw, 36px);
  margin-bottom: 16px;
}

.text-video-{{ section.id }} .rte {
  color: rgb(var(--color-foreground));
}

.text-video-{{ section.id }} .video-wrapper {
  border-radius: {{ section.settings.video_radius }}px;
  overflow: hidden;
}

.text-video-{{ section.id }} iframe,
.text-video-{{ section.id }} video {
  width: 100%;
  aspect-ratio: 16 / 9;
  display: block;
  border: 0;
}
{% endstyle %}

<section class="text-video-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="page-width wrapper">
    <div class="grid">

      <!-- LEFT CONTENT -->
      <div>
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="rte">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>

      <!-- RIGHT VIDEO -->
      <div class="video-wrapper">
        {% if section.settings.shopify_video != blank %}
          {{
            section.settings.shopify_video
            | video_tag:
              autoplay: false,
              controls: true,
              loop: false,
              muted: false
          }}
        {% elsif section.settings.video_url != blank %}

          {% assign video_url = section.settings.video_url %}

          {% if video_url contains 'youtu' %}
            {% assign video_id = video_url
              | replace: 'https://youtu.be/', ''
              | replace: 'https://www.youtube.com/watch?v=', ''
              | split: '&'
              | first
            %}
            <iframe
              src="https://www.youtube.com/embed/{{ video_id }}"
              allow="autoplay; encrypted-media"
              allowfullscreen
              loading="lazy">
            </iframe>

          {% elsif video_url contains 'vimeo' %}
            {% assign video_id = video_url | split: '/' | last %}
            <iframe
              src="https://player.vimeo.com/video/{{ video_id }}"
              allow="autoplay; encrypted-media"
              allowfullscreen
              loading="lazy">
            </iframe>
          {% endif %}

        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text with Video",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "XLfeet's founder, Adrian, wears size 16EE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your story content here.</p>"
    },
    {
      "type": "video",
      "id": "shopify_video",
      "label": "Shopify hosted video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "YouTube / Vimeo URL",
      "info": "Paste normal YouTube or Vimeo link"
    },
    {
      "type": "range",
      "id": "video_radius",
      "label": "Video border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Text with Video"
    }
  ]
}
{% endschema %}
