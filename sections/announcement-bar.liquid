{% comment %}
  Custom Announcement Bar (Left / Center / Right)
{% endcomment %}

<div class="utility-bar color-{{ section.settings.color_scheme }}">
  <div class="page-width announcement-bar-custom">

    <!-- LEFT -->
    <div class="announcement-item left">
      <span class="icon">☎</span>
      <a href="tel:+16517976000">+1 (651) 797-6000</a>
    </div>

    <!-- CENTER -->
    <div class="announcement-item center">
      <span>
        Enjoy Free shipping to India on all orders over ₹18,700!
      </span>
      <span class="arrow">→</span>
    </div>

    <!-- RIGHT -->
    <div class="announcement-item right">
      <span class="icon">✉</span>
      <a href="mailto:customercare@xfleet.com">customercare@xfleet.com</a>
    </div>

  </div>
</div>

<style>
.utility-bar {
  background: #0b0b0b;
  color: #ffffff;
  font-size: 13px;
}

.announcement-bar-custom {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  padding: 8px 0;
}

.announcement-item {
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

.announcement-item.center {
  justify-content: center;
  font-weight: 500;
  text-align: center;
}

.announcement-item a {
  color: #ffffff;
  text-decoration: none;
}

.arrow {
  margin-left: 6px;
}

/* Mobile */
@media screen and (max-width: 768px) {
  .announcement-bar-custom {
    grid-template-columns: 1fr;
    gap: 6px;
    text-align: center;
  }

  .announcement-item {
    justify-content: center;
  }
}
</style>

{% schema %}
{
  "name": "Announcement Bar Custom",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar Custom"
    }
  ]
}
{% endschema %}
