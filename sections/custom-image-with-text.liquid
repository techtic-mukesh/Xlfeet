{% comment %}
  Section: Image with text (CMS-ready)
  Theme: Shopify Dawn
{% endcomment %}

{{ 'component-rte.css' | asset_url | stylesheet_tag }}

<section class="image-text-cta color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="image-text-cta__grid image-text-cta__grid--{{ section.settings.image_position }}">
      
      {% if section.settings.image != blank %}
        <div class="image-text-cta__media">
          {{ section.settings.image | image_url: width: 1200 | image_tag:
            loading: 'lazy',
            widths: '375, 550, 750, 1100, 1500',
            class: 'image-text-cta__image'
          }}
        </div>
      {% endif %}

      <div class="image-text-cta__content">
        {% if section.settings.eyebrow != blank %}
          <p class="image-text-cta__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="image-text-cta__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="image-text-cta__text rte">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

.image-text-cta__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: center;
}

@media screen and (min-width: 750px) {
  .image-text-cta__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .image-text-cta__grid--right {
    direction: rtl;
  }

  .image-text-cta__grid--right > * {
    direction: ltr;
  }
}

.image-text-cta__image {
  width: 100%;
  height: auto;
  border-radius: 12px;
}

.image-text-cta__eyebrow {
    font-size: 30px;
    letter-spacing: 0;
    margin-bottom: 10px;
    font-family: var(--font-subheading-family);
}

.image-text-cta__heading {
    margin-bottom: 1.2rem;
    margin-top: 0;
}

.image-text-cta__text {
  margin-bottom: 2rem;
}
{% endstyle %}

{% schema %}
{
  "name": "Custom Image with text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Top text",
      "default": "Order online or come visit us in person"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fitting Extra Large Feet Is No Extra Large Feat®"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" },
        { "value": "h3", "label": "Small" }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p></p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Custom Image with text"
    }
  ]
}
{% endschema %}